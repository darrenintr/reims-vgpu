diff --git a/hw/display/reims-vgpu-dirty-test/README.md b/hw/display/reims-vgpu-dirty-test/README.md
new file mode 100644
index 0000000..5aa9d9b
--- /dev/null
+++ b/hw/display/reims-vgpu-dirty-test/README.md
@@ -0,0 +1,38 @@
+# reims-vgpu-dirty model check
+
+Drives the real `../reims-vgpu-dirty.c` against a model of the hypervisor dirty
+bitmap. No QEMU build is needed: `fake/` models exactly the QEMU surface the
+adapter touches (flat view, `DIRTY_MEMORY_VGA` bitmap, region logging, a
+main-loop bottom half) and nothing else.
+
+    ./run.sh [max-length]        # default 8; ~3.6 M interleavings in a few seconds
+    ./run.sh --mutant NAME 6     # a deliberately wrong shim; must FAIL
+
+## What it checks
+
+*Directed:* a tracked set arms with **no guest doorbell** — one main-loop harvest
+when logging is already on, two for the first region of a boot — and a burst of
+tracks costs one harvest.
+
+*Exhaustive:* every interleaving (to the length given) of guest writes `W0 W1`,
+doorbell harvest `H`, arming bottom half `B`, generation read `G`, host copy `C`
+and vouch check `V`, with the registration `T` at any point after up to two
+writes and harvests, in a world where logging is off and one where an earlier
+surface already turned it on. The reader follows the Rust protocol: read the
+generation, then copy, record the generation beside the copy.
+
+* **I** a vouched copy (generation unchanged) is never older than what the last
+  harvest had already seen — no guest write escapes;
+* **J** `written_since(armed_gen)` never names a page nobody wrote — a stale bit
+  must not read as a guest store, because the writeback rail drops the GPU's
+  store for pages it believes the guest wrote;
+* **K** every write a harvest saw after arming is named.
+
+## Mutants
+
+| name | what it breaks | caught by |
+|---|---|---|
+| `arm_at_track` | a "synchronous baseline": gen readable at track | J |
+| `no_unlogged` | arm in the harvest that enabled logging | J |
+| `no_hit_stamp` | do not stamp the pages the arming harvest absorbed | K |
+| `no_sync` | read the bitmap without folding hypervisor bits in | K |
diff --git a/hw/display/reims-vgpu-dirty-test/fake/exec/target_page.h b/hw/display/reims-vgpu-dirty-test/fake/exec/target_page.h
new file mode 100644
index 0000000..a7a036a
--- /dev/null
+++ b/hw/display/reims-vgpu-dirty-test/fake/exec/target_page.h
@@ -0,0 +1 @@
+#include "../fake_qemu.h"
diff --git a/hw/display/reims-vgpu-dirty-test/fake/fake_qemu.c b/hw/display/reims-vgpu-dirty-test/fake/fake_qemu.c
new file mode 100644
index 0000000..48587af
--- /dev/null
+++ b/hw/display/reims-vgpu-dirty-test/fake/fake_qemu.c
@@ -0,0 +1,195 @@
+/* See fake_qemu.h. SPDX-License-Identifier: GPL-2.0-or-later */
+#include "fake_qemu.h"
+
+AddressSpace address_space_memory;
+FakeRange fake_ranges[8];
+int fake_nranges;
+size_t fake_target_page = 4096;
+uint64_t fake_syncs;
+
+static MemoryRegion *world_mr(void)
+{
+    return fake_nranges ? fake_ranges[0].mr : NULL;
+}
+
+FlatView *address_space_to_flatview(AddressSpace *as)
+{
+    (void)as;
+    return (FlatView *)&fake_nranges;
+}
+
+void flatview_for_each_range(FlatView *fv, flatview_cb cb, void *opaque)
+{
+    int i;
+
+    (void)fv;
+    for (i = 0; i < fake_nranges; i++) {
+        FakeRange *r = &fake_ranges[i];
+
+        if (cb((Int128)r->gpa, (Int128)r->len, r->mr, r->offset, opaque)) {
+            return;
+        }
+    }
+}
+
+size_t qemu_target_page_size(void)
+{
+    return fake_target_page;
+}
+
+static uint64_t page_of(MemoryRegion *mr, ram_addr_t addr)
+{
+    return (addr - mr->ram_addr) / fake_target_page;
+}
+
+void memory_global_dirty_log_sync(bool last_stage)
+{
+    int i;
+
+    (void)last_stage;
+    fake_syncs++;
+    for (i = 0; i < fake_nranges; i++) {
+        MemoryRegion *mr = fake_ranges[i].mr;
+        uint64_t p;
+
+        if (!mr->logging) {
+            continue;
+        }
+        for (p = 0; p < mr->pages; p++) {
+            if (mr->kernel_dirty[p]) {
+                mr->ram_bit[p] = true;
+                mr->kernel_dirty[p] = false;
+            }
+        }
+    }
+}
+
+bool physical_memory_get_dirty_flag(ram_addr_t addr, unsigned client)
+{
+    MemoryRegion *mr = world_mr();
+
+    (void)client;
+    return mr->ram_bit[page_of(mr, addr)];
+}
+
+void memory_region_reset_dirty(MemoryRegion *mr, hwaddr addr, hwaddr size,
+                               unsigned client)
+{
+    uint64_t p;
+
+    (void)client;
+    for (p = addr / fake_target_page;
+         p < (addr + size + fake_target_page - 1) / fake_target_page; p++) {
+        mr->ram_bit[p] = false;
+        if (mr->logging) {
+            mr->protected_[p] = true;
+        }
+    }
+}
+
+void memory_region_set_log(MemoryRegion *mr, bool log, unsigned client)
+{
+    uint64_t p;
+
+    (void)client;
+    mr->logging = log;
+    for (p = 0; p < mr->pages; p++) {
+        /* Enabling logging write-protects the region; the QEMU bitmap is left
+         * exactly as it was, which is to say all-set until something clears it. */
+        mr->protected_[p] = log;
+    }
+}
+
+ram_addr_t memory_region_get_ram_addr(MemoryRegion *mr)
+{
+    return mr->ram_addr;
+}
+
+void memory_region_ref(MemoryRegion *mr) { mr->refs++; }
+void memory_region_unref(MemoryRegion *mr) { mr->refs--; }
+
+void fake_guest_write(MemoryRegion *mr, uint64_t page)
+{
+    mr->version[page]++;
+    if (mr->logging && mr->protected_[page]) {
+        mr->kernel_dirty[page] = true;
+        mr->protected_[page] = false;
+    }
+}
+
+/* ---- bottom half ---- */
+struct QEMUBH {
+    QEMUBHFunc *cb;
+    void *opaque;
+    bool pending;
+};
+static QEMUBH the_bh;
+static uint64_t bh_schedules;
+static bool bh_live;
+
+AioContext *qemu_get_aio_context(void) { return NULL; }
+
+QEMUBH *aio_bh_new(AioContext *ctx, QEMUBHFunc *cb, void *opaque)
+{
+    (void)ctx;
+    the_bh.cb = cb;
+    the_bh.opaque = opaque;
+    the_bh.pending = false;
+    bh_live = true;
+    return &the_bh;
+}
+
+void qemu_bh_schedule(QEMUBH *bh)
+{
+    __atomic_add_fetch(&bh_schedules, 1, __ATOMIC_RELAXED);
+    __atomic_store_n(&bh->pending, true, __ATOMIC_SEQ_CST);
+}
+
+void qemu_bh_delete(QEMUBH *bh)
+{
+    bh->pending = false;
+    bh_live = false;
+}
+
+bool fake_bh_pending(void)
+{
+    return bh_live && __atomic_load_n(&the_bh.pending, __ATOMIC_SEQ_CST);
+}
+
+bool fake_bh_run(void)
+{
+    if (!fake_bh_pending()) {
+        return false;
+    }
+    __atomic_store_n(&the_bh.pending, false, __ATOMIC_SEQ_CST);
+    the_bh.cb(the_bh.opaque);
+    return true;
+}
+
+uint64_t fake_bh_schedules(void)
+{
+    return __atomic_load_n(&bh_schedules, __ATOMIC_RELAXED);
+}
+
+/* ---- world ---- */
+static MemoryRegion the_mr;
+
+void fake_reset_world(void)
+{
+    uint64_t p;
+
+    memset(&the_mr, 0, sizeof(the_mr));
+    the_mr.ram = true;
+    the_mr.ram_addr = 0x40000000;
+    the_mr.pages = FAKE_MAX_PAGES;
+    for (p = 0; p < FAKE_MAX_PAGES; p++) {
+        the_mr.ram_bit[p] = true;   /* QEMU allocates RAM all-dirty */
+    }
+    fake_ranges[0] = (FakeRange){ .gpa = 0x100000,
+                                  .len = FAKE_MAX_PAGES * 4096ull,
+                                  .mr = &the_mr, .offset = 0 };
+    fake_nranges = 1;
+    fake_syncs = 0;
+    bh_schedules = 0;
+    the_bh.pending = false;
+}
diff --git a/hw/display/reims-vgpu-dirty-test/fake/fake_qemu.h b/hw/display/reims-vgpu-dirty-test/fake/fake_qemu.h
new file mode 100644
index 0000000..8bf4528
--- /dev/null
+++ b/hw/display/reims-vgpu-dirty-test/fake/fake_qemu.h
@@ -0,0 +1,102 @@
+/*
+ * A model of exactly the QEMU surface reims-vgpu-dirty.c uses, so the real
+ * adapter source can be driven by scripted guests. Not QEMU: it models the
+ * three layers that decide whether a guest store can be seen —
+ *
+ *   protected[]   the hypervisor's write protection of a logged page
+ *   kernel_dirty[] what the hypervisor recorded since the last sync
+ *   ram_bit[]     QEMU's DIRTY_MEMORY_VGA bitmap, which starts all-set
+ *
+ * — and nothing else. SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef FAKE_QEMU_H
+#define FAKE_QEMU_H
+
+#include <glib.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef uint64_t hwaddr;
+typedef uint64_t ram_addr_t;
+typedef __int128 Int128;
+#define DIRTY_MEMORY_VGA 0
+#define HWADDR_PRIx PRIx64
+
+static inline bool int128_nz(Int128 a) { return a != 0; }
+static inline uint64_t int128_get64(Int128 a) { return (uint64_t)a; }
+
+typedef struct QemuMutex { pthread_mutex_t m; } QemuMutex;
+static inline void qemu_mutex_init(QemuMutex *m) { pthread_mutex_init(&m->m, NULL); }
+static inline void qemu_mutex_destroy(QemuMutex *m) { pthread_mutex_destroy(&m->m); }
+static inline void qemu_mutex_lock(QemuMutex *m) { pthread_mutex_lock(&m->m); }
+static inline void qemu_mutex_unlock(QemuMutex *m) { pthread_mutex_unlock(&m->m); }
+
+#define RCU_READ_LOCK_GUARD() do { } while (0)
+
+#define FAKE_MAX_PAGES 64
+
+typedef struct MemoryRegion {
+    bool ram;
+    ram_addr_t ram_addr;
+    uint64_t pages;
+    bool logging;
+    bool protected_[FAKE_MAX_PAGES];
+    bool kernel_dirty[FAKE_MAX_PAGES];
+    bool ram_bit[FAKE_MAX_PAGES];
+    uint64_t version[FAKE_MAX_PAGES];   /* guest memory "contents" */
+    int refs;
+} MemoryRegion;
+
+typedef struct FakeRange {
+    hwaddr gpa;
+    uint64_t len;
+    MemoryRegion *mr;
+    hwaddr offset;
+} FakeRange;
+
+typedef struct FlatView FlatView;
+typedef struct AddressSpace { int unused; } AddressSpace;
+extern AddressSpace address_space_memory;
+
+typedef bool (*flatview_cb)(Int128 start, Int128 len, const MemoryRegion *mr,
+                            hwaddr offset_in_region, void *opaque);
+
+/* The test configures the flat view. */
+extern FakeRange fake_ranges[8];
+extern int fake_nranges;
+extern size_t fake_target_page;
+extern uint64_t fake_syncs;
+
+FlatView *address_space_to_flatview(AddressSpace *as);
+void flatview_for_each_range(FlatView *fv, flatview_cb cb, void *opaque);
+size_t qemu_target_page_size(void);
+void memory_global_dirty_log_sync(bool last_stage);
+bool physical_memory_get_dirty_flag(ram_addr_t addr, unsigned client);
+void memory_region_reset_dirty(MemoryRegion *mr, hwaddr addr, hwaddr size,
+                               unsigned client);
+void memory_region_set_log(MemoryRegion *mr, bool log, unsigned client);
+ram_addr_t memory_region_get_ram_addr(MemoryRegion *mr);
+void memory_region_ref(MemoryRegion *mr);
+void memory_region_unref(MemoryRegion *mr);
+
+typedef struct QEMUBH QEMUBH;
+typedef struct AioContext AioContext;
+typedef void QEMUBHFunc(void *opaque);
+AioContext *qemu_get_aio_context(void);
+QEMUBH *aio_bh_new(AioContext *ctx, QEMUBHFunc *cb, void *opaque);
+void qemu_bh_schedule(QEMUBH *bh);
+void qemu_bh_delete(QEMUBH *bh);
+
+/* Test-side controls. */
+void fake_reset_world(void);
+void fake_guest_write(MemoryRegion *mr, uint64_t page);
+bool fake_bh_pending(void);
+/* Run the pending bottom half under the (modelled) BQL; false if none. */
+bool fake_bh_run(void);
+uint64_t fake_bh_schedules(void);
+
+#endif
