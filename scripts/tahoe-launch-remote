#!/usr/bin/env bash
# Start-menu launcher for the existing macOS Tahoe VM.
# Uses GitHub Release binaries instead of building QEMU locally.
# Preserves focus, stop, clipboard synchronization and SSH-ready notifications.
# Requires ~/.local/bin/reims-release (GitHub-managed downloader).
set -uo pipefail

VM=tahoe
DATA=${REIMS_CTL_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/reims-ctl}
QEMU_ROOT=$DATA/qemu
RELEASE_MANAGER=$HOME/.local/bin/reims-release
LEGACY_CTL=$HOME/.local/bin/reims-ctl
PIDFILE=$DATA/vms/$VM/qemu.pid
LOG=${XDG_STATE_HOME:-$HOME/.local/state}/tahoe-launch.log
STATE=$DATA/release-manager.json
mkdir -p "$(dirname "$LOG")"

notify() { command -v notify-send >/dev/null && notify-send -a 'macOS Tahoe' -i computer "$@" 2>/dev/null || true; }
running() { [[ -f $PIDFILE ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }
current_ctl() {
  if [[ -x "$QEMU_ROOT/current/bin/reims-ctl" ]]; then
    printf '%s\n' "$QEMU_ROOT/current/bin/reims-ctl"
  elif [[ -x "$LEGACY_CTL" ]]; then
    printf '%s\n' "$LEGACY_CTL"
  else
    return 1
  fi
}

dialog_question() {
  local title=$1 message=$2
  if command -v kdialog >/dev/null; then
    kdialog --title "$title" --yesno "$message" 2>/dev/null
  elif command -v zenity >/dev/null; then
    zenity --question --title="$title" --text="$message" 2>/dev/null
  elif [[ -t 0 ]]; then
    local answer
    read -r -p "$message [Y/n] " answer
    [[ -z "$answer" || "$answer" =~ ^[yY]([eE][sS])?$ ]]
  else
    # Headless/non-interactive fallback: notify and proceed with the update.
    # Install kdialog on KDE if you want explicit graphical confirmation.
    notify 'GUI confirmation unavailable' 'Downloading the selected GitHub build automatically.'
    return 0
  fi
}

show_test_guide() {
  local message
  message=$'推荐顺序：\n1. Stable v0.1.2：Native-v3 + Fat-LTO，新的性能基准。\n2. QEMU THP：发布后在相同编译配置下测试内存大页优化。\n3. QEMU USB 安全修复：检查稳定性及兼容性。\n4. GPU FIFO / Dirty-page：未来独立性能实验。\n5. Profiler：仅用于诊断卡顿，不用于性能排名。\n\n旧版 Native-v3 和 Fat-LTO 独立构建已经归入历史版本。\n\n每版保持相同 VM 磁盘状态、CPU 绑定和分辨率；先测 Finder 拖窗 30 秒，再测 Safari 滚动 30 秒、Launchpad 动画 10 次。\n启用 FPS 监控，记录 guest/window FPS 与 max gap；空闲时的 0 FPS 不代表卡顿。日志中的 max gap 不等于 p95/p99，需要更细粒度仪器才能统计。'
  if command -v kdialog >/dev/null; then
    kdialog --title 'macOS Tahoe · 测试说明' --msgbox "$message"
  elif command -v zenity >/dev/null; then
    zenity --info --title='macOS Tahoe · 测试说明' --width=620 --text="$message"
  else
    printf '%s\n' "$message" >&2
  fi
}

choose_release_page() {
  local page=$1 data tag label
  local -a choices=()
  if [[ $page == curated ]]; then
    data=$("$RELEASE_MANAGER" --list --curated --json 2>>"$LOG") || return 1
  elif [[ $page == diagnostics ]]; then
    data=$("$RELEASE_MANAGER" --list --diagnostics --json 2>>"$LOG") || return 1
  else
    data=$("$RELEASE_MANAGER" --list --json 2>>"$LOG") || return 1
  fi
  while IFS=$'\t' read -r tag label; do
    [[ -n "$tag" ]] && choices+=("$tag" "$label")
  done < <(
    printf '%s' "$data" | python3 -c '
import json, sys
try:
    releases = json.load(sys.stdin)
except (ValueError, TypeError):
    releases = []
for r in releases:
    tag = str(r.get("tag", ""))
    label = str(r.get("test_label") or r.get("name") or tag).replace("\n", " ").replace("\t", " ")
    status = " [已下载]" if r.get("installed") else ""
    selected = " [已选中]" if r.get("current") else ""
    older = " [旧版]" if r.get("historical") else ""
    print(tag + "\t" + label + status + selected + older)
' 2>>"$LOG"
  )
  ((${#choices[@]})) || return 1
  local prompt
  if [[ $page == curated ]]; then
    choices+=('__guide__' '【测试说明】 推荐顺序、场景与记录指标')
    choices+=('__diagnostics__' '【诊断工具】 FPS Profiler / 卡顿排查')
    choices+=('__history__' '【历史及回滚】 查看全部已发布版本')
    choices+=('__cleanup__' '【清理本机缓存】 预览并移除过期下载版本（不删除 GitHub Release）')
    local chosen
    chosen=$(readlink -f "$QEMU_ROOT/current" 2>/dev/null || true)
    prompt="请选择本次测试的目标（本机安装已选：${chosen##*/}；旧版请查看历史）："
  else
    choices=('__back__' '【返回】 最新推荐测试版本' "${choices[@]}")
    prompt='请选择历史版本或诊断版本（旧版不会自动删除）：'
  fi
  if command -v kdialog >/dev/null; then
    kdialog --title 'macOS Tahoe · 测试版本' --menu \
      "$prompt" "${choices[@]}" 2>/dev/null
  elif command -v zenity >/dev/null; then
    printf '%s\n' "${choices[@]}" | paste -d '\t' - - |
      zenity --list --title='macOS Tahoe · 测试版本' \
        --text="$prompt" --column='Tag' --column='Description' \
        --hide-column=1 --print-column=1 2>/dev/null
  elif [[ -t 0 ]]; then
    local i answer idx
    for ((i=0; i<${#choices[@]}; i+=2)); do
      printf '%2d: %s\n' "$((i/2+1))" "${choices[i+1]}" >&2
    done
    read -r -p '选择版本编号：' answer
    [[ "$answer" =~ ^[0-9]+$ ]] || return 1
    idx=$(( (answer-1)*2 ))
    ((idx>=0 && idx<${#choices[@]})) || return 1
    printf '%s\n' "${choices[idx]}"
  else
    notify 'Select a GitHub release' 'Install kdialog for graphical version selection'
    return 1
  fi
}

show_cleanup_dialog() {
  if running; then
    notify -u critical '无法清理' '请先关闭 macOS Tahoe 虚拟机'
    return 1
  fi
  local preview summary plan result
  preview=$("$RELEASE_MANAGER" --cleanup-preview --json 2>>"$LOG") || {
    notify -u critical '无法预览清理列表' "检查网络与 $LOG"
    return 1
  }
  summary=$(printf '%s' "$preview" | python3 -c '
import json, sys
p = json.load(sys.stdin)
items = p.get("candidates", [])
if not items:
    print("没有需要清理的旧版安装。当前 Stable、诊断工具和选中版本均已保护。")
else:
    print("只移除以下本机已下载的旧版，不影响 VM 数据或 GitHub Release：\n")
    for i in items:
        print(f"• {i["tag"]}: {i["bytes"]/1048576:.1f} MiB")
    print(f"\n预计释放约 {p["total_bytes"]/1048576:.1f} MiB。")
    print("\nStable、当前选择的版本、最新实验及 Profiler 均不会删除。")
    print("执行前会再次检查是否有 QEMU 运行，以及清理列表是否改变。")
') || return 1
  plan=$(printf '%s' "$preview" | python3 -c '
import json,sys
p=json.load(sys.stdin)
if p.get("candidates"): print(p["plan_id"])
') || return 1
  if [[ -z "$plan" ]]; then
    if command -v kdialog >/dev/null; then
      kdialog --title 'macOS Tahoe · 清理完成' --msgbox "$summary"
    elif command -v zenity >/dev/null; then
      zenity --info --title='macOS Tahoe · 无需清理' --text="$summary"
    else
      notify '无需清理' "$summary"
    fi
    return 0
  fi
  if command -v kdialog >/dev/null; then
    kdialog --title 'macOS Tahoe · 确认清理' --yesno "$summary" 2>/dev/null || return 0
  elif command -v zenity >/dev/null; then
    zenity --question --title='macOS Tahoe · 确认清理' --text="$summary" 2>/dev/null || return 0
  elif [[ -t 0 ]]; then
    printf '%s\n' "$summary" >&2
    local answer
    read -r -p '输入 DELETE 才能清理：' answer
    [[ "$answer" == DELETE ]] || return 0
  else
    notify -u critical '安全确认不可用' '清理缓存需要图形确认或终端输入 DELETE'
    return 1
  fi
  # Never auto-confirm cleanup in a headless session.
  result=$("$RELEASE_MANAGER" --cleanup-apply --confirm --plan-id "$plan" 2>>"$LOG") || {
    notify -u critical '清理已取消或失败' "请查看 $LOG"
    return 1
  }
  notify '已清理过期安装' "$result"
  if command -v kdialog >/dev/null; then
    kdialog --title 'macOS Tahoe · 缓存清理完成' --msgbox "$result"
  fi
}

choose_release() {
  local page=curated result
  while :; do
    result=$(choose_release_page "$page") || return 1
    case $result in
      __history__) page=history ;;
      __diagnostics__) page=diagnostics ;;
      __back__) page=curated ;;
      __guide__) show_test_guide ;;
      __cleanup__) show_cleanup_dialog ;;
      *) printf '%s\n' "$result"; return 0 ;;
    esac
  done
}

test_goal_for_tag() {
  case $1 in
    v0.1.2) printf '%s\n' '最新 Stable：Native-v3 + Fat-LTO，需支持 x86-64-v3；新的性能比较基线' ;;
    v0.1.1) printf '%s\n' '上一个 Stable：仅 Native-v3，性能回归时可回滚' ;;
    v0.1.0) printf '%s\n' '原 Stable：通用 x86-64 回滚版本' ;;
    v*) printf '%s\n' 'Stable：按同样场景测量 Finder / Safari / Launchpad 的帧时间' ;;
    testing-14-*) printf '%s\n' '兼容性对照：与 Stable GPU 核心相同，检查启动器及现有顺畅度' ;;
    testing-*) printf '%s\n' 'Testing：先查 Release 变更，再做相同场景性能及回归测试' ;;
    exp-native-v3-fat-lto-*) printf '%s\n' 'Native-v3 + Fat-LTO：首个组合实验已提升为 Stable v0.1.2，其他版本按发行说明测试' ;;
    exp-native-v3-*) printf '%s\n' 'CPU ISA：仅比较 x86-64-v3 代码生成的性能影响' ;;
    exp-fat-lto-*) printf '%s\n' 'LTO：仅比较 Fat LTO 编译优化的性能影响' ;;
    exp-profiler-*) printf '%s\n' 'Profiler：定位卡顿，不用于性能排名' ;;
    exp-qemu-thp-*) printf '%s\n' 'QEMU THP：检查 memfd 2 MiB 对齐及帧时间变化' ;;
    *) printf '%s\n' '未知实验：先阅读 GitHub Release 说明' ;;
  esac
}

choose_debug() {
  case ${TAHOE_DEBUG_MODE:-} in off|fps|gpu) echo "$TAHOE_DEBUG_MODE"; return ;; esac
  local -a choices=(
    fps '【推荐测试】 FPS / GPU 估算耗时 / 最大帧间隔'
    off '【日常使用】 关闭额外性能日志'
    gpu '【排查卡顿】 FPS + 更详细的 GPU 调试日志（有开销）'
  )
  if [[ $TAG == exp-profiler-* ]]; then
    choices=(
      gpu '【Profiler 推荐】 收集详细时序以定位卡顿'
      fps '仅收集每秒 FPS 与 max gap'
      off '关闭监控'
    )
  fi
  if command -v kdialog >/dev/null; then
    kdialog --title 'macOS Tahoe · Performance' --menu \
      '本次测试建议启用 FPS；监控会有少量开销：' "${choices[@]}" 2>/dev/null
  elif command -v zenity >/dev/null; then
    printf '%s\n' "${choices[@]}" | paste -d '\t' - - |
      zenity --list --title='macOS Tahoe · Performance' \
        --text='本次测试的日志等级' --column='Mode' --column='Description' \
        --hide-column=1 --print-column=1 2>/dev/null
  elif [[ -t 0 ]]; then
    local answer
    read -r -p 'Performance [fps/off/gpu] (default fps): ' answer
    case "$answer" in off|gpu) echo "$answer";; *) echo fps;; esac
  else
    echo fps
  fi
}
open_monitor() {
  local logfile=$DATA/vms/$VM/logs/qemu.log
  if command -v konsole >/dev/null; then
    konsole -e tail -n 30 -F "$logfile" >/dev/null 2>&1 &
    disown
  elif command -v xterm >/dev/null; then
    xterm -T 'Tahoe performance' -e tail -n 30 -F "$logfile" >/dev/null 2>&1 &
    disown
  else
    notify 'Performance log' "$logfile"
  fi
}

# These paths must work without connecting to GitHub or switching QEMU versions.
if [[ ${1:-} == --stop ]]; then
  if ! running; then notify 'Tahoe is not running'; exit 0; fi
  CTL=$(current_ctl) || { notify -u critical 'Cannot find reims-ctl'; exit 1; }
  notify 'Shutting Tahoe down…'
  "$CTL" stop "$VM" >>"$LOG" 2>&1 && notify 'Tahoe is off' || {
    notify -u critical 'Tahoe did not stop' "See $LOG"
    exit 1
  }
  exit 0
fi
if [[ ${1:-} == --monitor ]]; then
  open_monitor
  exit 0
fi
if running; then
  WINDOW=$HOME/.local/bin/reims-window
  if [[ -x "$WINDOW" ]]; then exec "$WINDOW" focus; fi
  notify 'Tahoe is already running' 'Focus the macOS window from the desktop.'
  exit 0
fi

# The Start Menu shows only latest purposeful builds; history remains available.
# TAHOE_RELEASE_TAG or --tag can bypass the dialog for custom desktop entries.
TAG=${TAHOE_RELEASE_TAG:-}
case ${1:-} in
  '') ;;
  --tag) TAG=${2:-} ;;
  --tag=*) TAG=${1#--tag=} ;;
  *) notify -u critical 'Invalid Tahoe launcher option' "$1"; exit 2 ;;
esac
[[ -x "$RELEASE_MANAGER" ]] || {
  notify -u critical 'GitHub release manager missing' "Install $RELEASE_MANAGER first"
  exit 1
}
if [[ -z "$TAG" ]]; then
  TAG=$(choose_release) || exit 0
fi
[[ "$TAG" =~ ^[A-Za-z0-9._-]+$ ]] || {
  notify -u critical 'Invalid Release tag' "$TAG"
  exit 2
}
ARGS=(--tag "$TAG" --install-only)
if [[ -x "$QEMU_ROOT/$TAG/bin/reims-ctl" && -x "$QEMU_ROOT/$TAG/bin/qemu-system-x86_64" ]]; then
  ARGS+=(--no-check)
elif ! dialog_question 'macOS Tahoe · Download' \
  "下載 GitHub Release $TAG？"$'\n'"只下載已編譯的 QEMU，不會在本機編譯。"; then
  exit 0
fi
TEST_GOAL=$(test_goal_for_tag "$TAG")
MODE=$(choose_debug) || exit 0
case "$MODE" in
  off)
    export REIMS_CTL_SESSION_STATS=0
    export REIMS_CTL_SESSION_LOG=warn ;;
  fps)
    # Older stable builds also inherit this variable from reims-ctl's process.
    export REIMS_VGPU_STATS=1
    export REIMS_CTL_SESSION_STATS=1
    export REIMS_CTL_SESSION_LOG=warn ;;
  gpu)
    export REIMS_VGPU_STATS=1
    export REIMS_CTL_SESSION_STATS=1
    export REIMS_CTL_SESSION_LOG='warn,reims_vgpu_vulkan::gpu::timing=debug'
    export M2V_SCHED_STATS=1
    case "$TAG" in
      exp-*) ;;
      *) notify 'GPU Timing compatibility' 'Older releases can show FPS; detailed timing requires a new experiment build.' ;;
    esac ;;
  *) exit 0 ;;
esac
{
  echo "==== $(date '+%F %T') $VM release=$TAG performance=$MODE"
  echo "TEST GOAL: $TEST_GOAL"
  echo "Previous QEMU: $(readlink -f "$QEMU_ROOT/current" 2>/dev/null || echo none)"
} >>"$LOG"
notify 'Preparing macOS Tahoe' "Release $TAG · $MODE"
if ! "$RELEASE_MANAGER" "${ARGS[@]}" >>"$LOG" 2>&1; then
  notify -u critical 'Tahoe build unavailable' "Could not select $TAG. See $LOG"
  exit 1
fi
USING_LEGACY=0
# Do not accidentally run an older reims-ctl or an overridden source-build QEMU.
if [[ $USING_LEGACY == 1 ]]; then
  CTL=$LEGACY_CTL
else
  CTL=$QEMU_ROOT/current/bin/reims-ctl
  if [[ ! -x "$CTL" ]]; then
    notify -u critical 'Incomplete prebuilt QEMU installation' "Missing $CTL"
    exit 1
  fi
  unset REIMS_CTL_QEMU
fi

{
  echo "QEMU: $(readlink -f "$QEMU_ROOT/current")"
  "$CTL" --version
} >>"$LOG" 2>&1
notify 'Starting macOS Tahoe' "Using $TAG · $MODE"
notify '本次测试目的' "$TEST_GOAL"

if ! "$CTL" start "$VM" >>"$LOG" 2>&1; then
  notify -u critical 'Tahoe failed to start' "$(tail -n 5 "$LOG")"
  exit 1
fi
if [[ "$MODE" != off ]]; then
  open_monitor
fi

# Original clipboard bridge: restart so it reconnects when macOS SSH is ready.
systemctl --user restart mac-clip-sync.service 2>>"$LOG" ||
  notify 'Clipboard sync is not running' 'systemctl --user status mac-clip-sync'

(
  for _ in $(seq 120); do
    running || exit 0
    if ssh -o BatchMode=yes -o ConnectTimeout=3 macos-vm true 2>/dev/null; then
      notify 'Tahoe is up' 'Clipboard synced · Meta+Shift+F full screen · Meta+Shift+W windowed'
      exit 0
    fi
    sleep 5
  done
  notify 'Tahoe: clipboard sync not connected' 'Guest SSH (macos-vm) did not answer'
) >>"$LOG" 2>&1 &
disown